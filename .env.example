# ============================================================
# Pancharm MAS — .env.example
# Danh sách này khớp 1:1 với core/config.py::Setting — không thêm biến app không đọc.
# Bản production sẵn để paste lên VPS: resources/setup/3_env-production.md
# ============================================================

# ── App ───────────────────────────────────────────────────────────────────
APP_NAME="Pancharm AI Retail Consultant"
APP_VERSION=1.0.0
APP_DESCRIPTION="Multi-Agent System for Feng Shui Jewelry Retail Consultation"
API_ENDPOINT=http://localhost:8088
API_PATH=/api/v1

# ── MySQL (DB chính, dùng bởi database/database.py + database/mysql_manager.py) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=ai_chatbot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── ChromaDB — chạy embedded (PersistentClient), chỉ CHROMA_PATH có tác dụng thật ──
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PATH=./chroma_db

# ── LLM Provider — "anthropic" | "gemini" ────────────────────────────────
LLM_PROVIDER=gemini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_REASONING_EFFORT=medium
ANTHROPIC_REASONING_MIN_MAX_TOKENS=2048

# Google AI Studio (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash

OPENAI_API_KEY=

# ── Redis (cache + LangGraph checkpointer nếu là Redis Stack) ───────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth (JWT) ────────────────────────────────────────────────────────────
SECRET_KEY=pancharm_mas_secret
ALGORITHM=HS512
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_MINUTES=30

# ── CORS — JSON array, vd '["https://pancharm.vn","https://admin.pancharm.vn"]' ──
ALLOWED_ORIGINS=["http://localhost:5173"]

# ── MinIO (khai báo sẵn trong config, hiện CHƯA có service/code nào dùng) ──
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=123456789
MINIO_USE_SSL=false

# ── LangSmith tracing (tuỳ chọn) ──────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=pancharm-mas

# ── Telegram (bot đăng ký webhook lúc app startup — xem adapter/setup.py) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=

# ── Facebook Messenger (tự setup sau — để trống thì adapter không đăng ký) ──
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=

# ── Zalo OA (tự setup sau) ────────────────────────────────────────────────
ZALO_OA_ACCESS_TOKEN=
ZALO_APP_SECRET=

# ── Kafka (optional — để trống KAFKA_BOOTSTRAP_SERVERS thì app tự fallback
#    sang xử lý webhook trực tiếp qua BackgroundTasks, xem main.py::lifespan) ──
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CLIENT_ID=pancharm-mas
KAFKA_CONSUMER_GROUP=pancharm-mas

# ============================================================
# Các biến dưới đây KHÔNG nằm trong core/config.py::Setting — chỉ được
# docker-compose.yml đọc để khởi tạo container MySQL/Redis lúc build,
# Python app không đọc trực tiếp các biến này.
# ============================================================
MYSQL_ROOT_PASSWORD=changeme
