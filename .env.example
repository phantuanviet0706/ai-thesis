# Global config for App
APP_NAME="AI Smart Chatbot"
APP_VERSION=1.0.0
APP_DESCRIPTION="AI Smart Chatbot Backend API"

# API configuration
API_ENDPOINT=http://localhost:8088
API_PATH=/api/v1/

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=ai_chatbot

# Connection Pool Settings MySQL
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=123456
PG_NAME=ai_chatbot

# Connection Pool Settings MySQL
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=20

# ChromaDB Configuration
CHROMA_PATH=D:/project/learning/thesis/chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
COLLECTION_NAME=chatbot

# Config Encode Algorithm
SECRET_KEY=SECRET_KEY
ALGORITHM=HS512
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# Config Redis
REDIS_HOST=localhost
REDIS_PORT=6379
#REDIS_PASSWORD=123456

# Config Kafka

# LangGraph Checkpoint Serialization
LANGGRAPH_ALLOWED_MSGPACK_MODULES=entity.product_doc,graph.state

# Config MinIO
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=USERNAME
MINIO_SECRET_KEY=PASSWORD

# LLM Provider — "anthropic" | "gemini" (mặc định gemini, xem core/llm_factory.py)
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=ANTHROPIC_API_KEY
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Adaptive thinking (reasoning) cho tier PRIMARY — xem core/llm_factory.py
ANTHROPIC_REASONING_EFFORT=medium
ANTHROPIC_REASONING_MIN_MAX_TOKENS=2048
GEMINI_API_KEY=GEMINI_API_KEY
GEMINI_MODEL_PRIMARY=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash

# Ollama Model Config
OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face Configuration
HF_TOKEN=HF_TOKEN

# Facebook API Config
FB_PAGE_ID=FB_PAGE_ID
FB_ACCESS_TOKEN=FB_ACCESS_TOKEN

